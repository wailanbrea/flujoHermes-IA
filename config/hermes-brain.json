      { "capability": "architecture", "profile": "architectureexpert", "executor": "local-advisory", "fallback": "cloud-director", "riskClass": "low", "executionCapability": "sandbox-code", "approvalRequirement": "none", "requiredToolsets": ["context_engine", "skills"], "requiredSkills": ["architecture-diagram"] },
