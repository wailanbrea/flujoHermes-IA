{
  "schemaVersion": 1,
  "principles": [
    "Hermes Brain is the persistent controlled operator for local conversations, research, skills, and task routing.",
    "Graphify is queried before broad project navigation.",
    "Any project edit occurs only inside an isolated Git worktree with checkpoints and explicit approval.",
    "Only reproducible evidence permits integration.",
    "Learning is derived only from validated outcomes.",
    "Only ingress from an already-authenticated official OpenClaw WS/RPC context reaches the Brain.",
    "OpenClaw remains the source of truth for sessions, routing, and channels.",
    "All side effects are authorized by the execution gateway."
  ],
  "modelRouter": {
    "policy": "capability-first",
    "atomicDecompositionScope": "local-only",
    "tokenBudgetPolicy": "local-atomic-cloud-streamlined",
    "hermesExternalInference": "disabled",
    "localTimeoutSeconds": 45,
    "routes": [
      { "capability": "classification", "profile": "clasificador", "executor": "local-optional", "fallback": "director", "riskClass": "low", "executionCapability": "sandbox-code", "approvalRequirement": "none", "requiredToolsets": ["context_engine", "skills"], "requiredSkills": ["hermes-model-router"] },
      { "capability": "sanitized-summary", "profile": "hermesbrain", "executor": "local-optional", "fallback": "director", "riskClass": "low", "executionCapability": "sandbox-code", "approvalRequirement": "none", "requiredToolsets": ["context_engine", "skills"], "requiredSkills": ["hermes-brain"] },
      { "capability": "research", "profile": "researchexpert", "executor": "local-controlled", "fallback": "director", "riskClass": "low", "executionCapability": "external-automation", "approvalRequirement": "none", "requiredToolsets": ["context_engine", "skills"], "requiredSkills": ["tech-research-agent"] },
