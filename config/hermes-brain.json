{
  "schemaVersion": 1,
  "principles": [
    "Hermes Brain is the persistent control plane, not the code author.",
    "Graphify is queried before broad project navigation.",
    "Cloud directors edit only inside isolated Git worktrees.",
    "Only reproducible evidence permits integration.",
    "Learning is derived only from validated outcomes."
  ],
  "modelRouter": {
    "policy": "capability-first",
    "localTimeoutSeconds": 45,
    "routes": [
      { "capability": "classification", "executor": "local-optional", "fallback": "director" },
      { "capability": "sanitized-summary", "executor": "local-optional", "fallback": "director" },
      { "capability": "architecture", "executor": "cloud-expert", "fallback": "director" },
      { "capability": "programming", "executor": "cloud-director", "fallback": "none" },
      { "capability": "critical-security", "executor": "cloud-security-expert", "fallback": "static-rules" },
      { "capability": "testing", "executor": "deterministic-scripts", "fallback": "director" },
      { "capability": "integration", "executor": "evidence-gate", "fallback": "blocked" }
    ],
    "localModel": "google/gemma-4-12b-qat",
    "manualOnlyModels": ["qwen3.6-35b-a3b-uncensored-hauhaucs-aggressive"]
  },
  "profiles": [
    { "id": "hermes-brain", "runtimeId": "hermesbrain", "role": "control-plane coordinator", "mode": "read-only" },
    { "id": "architecture-expert", "runtimeId": "architectureexpert", "role": "architecture reviewer", "mode": "read-only" },
    { "id": "security-expert", "runtimeId": "securityexpert", "role": "security reviewer", "mode": "read-only" },
    { "id": "testing-expert", "runtimeId": "testingexpert", "role": "test strategist", "mode": "read-only" },
    { "id": "frontend-expert", "runtimeId": "frontendexpert", "role": "frontend and Playwright advisor", "mode": "read-only" },
    { "id": "backend-expert", "runtimeId": "backendexpert", "role": "backend reviewer", "mode": "read-only" },
    { "id": "data-expert", "runtimeId": "dataexpert", "role": "data and database advisor", "mode": "read-only" },
    { "id": "learning-curator", "runtimeId": "learningcurator", "role": "learning and skill reviewer", "mode": "read-only" }
  ],
  "skills": {
    "core": [
      "hermes-brain",
      "hermes-agent-factory",
      "hermes-model-router",
      "hermes-learning-engine",
      "hermes-evidence-gate",
      "hermes-memory-retrieval",
      "graphify"
    ],
    "project": [
      "bsolutions-api-review",
      "bsolutions-debugging",
      "bsolutions-kotlin-android",
      "bsolutions-laravel",
      "bsolutions-mysql",
      "bsolutions-playwright",
      "bsolutions-project-handoff",
      "bsolutions-quality-gate",
      "bsolutions-security-review"
    ]
  },
  "memory": {
    "policy": "validated-and-sanitized-only",
    "graphFirst": true,
    "forbidden": ["full prompts", "full responses", "credentials", "session identifiers", "absolute private paths"]
  },
  "learning": {
    "states": ["candidate", "validated", "promoted", "deprecated"],
    "requiresValidatedTask": true,
    "promotionRequires": ["passing benchmark", "explicit approval"]
  },
  "validators": [
    "clean-source",
    "allowlist",
    "line-budget",
    "binary-deny",
    "lf-only-patch",
    "sha256",
    "git-apply-check",
    "independent-tests"
  ],
  "autonomy": {
    "localAiCanWrite": false,
    "expertProfilesCanWrite": false,
    "dashboardCanAuthorize": false,
    "deployments": "denied",
    "databaseMutation": "denied",
    "secrets": "denied"
  },
  "observability": {
    "statusPath": "telemetry/runtime/hermes-brain-status.json",
    "inventoryPath": "telemetry/runtime/hermes-brain-inventory.json",
    "dashboardUrl": "http://127.0.0.1:4310",
    "apiUrl": "http://127.0.0.1:4311/api/status"
  }
}
