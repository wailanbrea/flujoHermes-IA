      { "capability": "testing", "profile": "testingexpert", "executor": "deterministic-scripts", "fallback": "local-advisory", "riskClass": "medium", "executionCapability": "playwright-validation", "approvalRequirement": "none", "requiredToolsets": ["context_engine", "skills"], "requiredSkills": ["bsolutions-playwright"] },
      { "capability": "integration", "profile": "quality", "executor": "evidence-gate", "fallback": "blocked", "riskClass": "high", "executionCapability": "sandbox-code", "approvalRequirement": "evidence-gate", "requiredToolsets": ["context_engine", "skills"], "requiredSkills": ["hermes-evidence-gate", "bsolutions-quality-gate"] }
